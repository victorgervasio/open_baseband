{
  "configurations": {
    "Python: Debug sim.py (tta) - open_baseband/openasip/sim venv": {
      "adapter": "debugpy",
      "breakpoints": {
        "exception": {
          "raised": "N",
          "uncaught": "Y",
          "userUnhandled": "N"
        }
      },
      "configuration": {
        "python": "../../build/openasip/sim/venv/bin/python3",
        "request": "launch",
        "type": "python",
        "cwd": "${workspaceRoot}",
        "program": "sim.py",
        "args": [
            "--target", "tta",
            "--simulator", "ttasim",
            "--adf_file", "../arch/5gnr_ue_baseband_proc_sim.adf",
            "--tpef_file", "../../build/openasip/build-tta/openasip/targets/tta/sim/kernels/${tech}/${kernel}/${tech}_${kernel}_sim.tpef",
            "--sim_root", "../../build/openasip/build-tta/openasip/sim"
        ],
        "console": "integratedTerminal",
        "breakpoints": {
          "exception": {
            "all": "N",
            "uncaught": "Y"
          }
        },
        "stopOnEntry": false
      }
    },
    "Python: Debug sim.py (x86_64) - open_baseband/openasip/sim venv": {
      "adapter": "debugpy",
      "breakpoints": {
        "exception": {
          "raised": "N",
          "uncaught": "Y",
          "userUnhandled": "N"
        }
      },
      "configuration": {
        "python": "../../build/openasip/sim/venv/bin/python3",
        "request": "launch",
        "type": "python",
        "cwd": "${workspaceRoot}",
        "program": "sim.py",
        "args": [
            "--target", "x86_64",
            "--x86_64_program", "../../build/openasip/build-x86_64/openasip/targets/x86_64/kernels/${tech}/${kernel}/x86_64-ldpc"
        ],
        "console": "integratedTerminal",
        "breakpoints": {
          "exception": {
            "all": "N",
            "uncaught": "Y"
          }
        },
        "stopOnEntry": false
      }
    },
    "CPP: Debug ttasim (tta) - <openasip-devel-root>/openasip/src/codesign/ttasim": {
      "adapter": "vscode-cpptools",
      "breakpoints": {
        "exception": {
          "all": "N",
          "raised": "N",
          "uncaught": "Y",
          "userUnhandled": "N"
        }
      },
      "configuration": {
        "request": "launch",
        "cwd": "${workspaceRoot}",
        "program": "${HOME}/local/bin/ttasim",
        "args": [
        "-a",
        "${workspaceRoot}/../arch/5gnr_ue_baseband_proc_sim.adf",
        "-p",
        "${workspaceRoot}/../../build/openasip/build-tta/openasip/targets/tta/sim/kernels/5gnr/ldpc/5gnr_ldpc_sim.tpef"
        ],
        "stopAtEntry": true,
        "type": "cppdbg",
        "MIMode": "gdb",
        "console": "integratedTerminal",
        "setupCommands": [
          {
            "description": "Enable pretty printing",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    },
    "Python: Debug sim.py (tta-systemC) - open_baseband/openasip/sim venv": {
      "adapter": "debugpy",
      "breakpoints": {
        "exception": {
          "raised": "N",
          "uncaught": "Y",
          "userUnhandled": "N"
        }
      },
      "configuration": {
        "python": "../../build/openasip/sim/venv/bin/python3",
        "request": "launch",
        "type": "python",
        "cwd": "${workspaceRoot}",
        "program": "sim.py",
        "args": [
            "--target", "tta",
            "--systemC",
            "--sim_root", "../../build/openasip/build-tta/openasip/sim",
            "--x86_64_program", "../../build/openasip/build-tta/openasip/targets/tta/sim/kernels/${tech}/${kernel}/sim_${tech}_${kernel}",
            "--x86_64_program_args", "${argv1}", "${argv2}", "${argv3}", "${argv4}"
        ],
        "console": "integratedTerminal",
        "breakpoints": {
          "exception": {
            "all": "N",
            "uncaught": "Y"
          }
        },
        "stopOnEntry": false
      }
    }
  }
}
