`timescale 1ns/1ps

module tb_cn_proc;

    // -----------------------------------------
    // Parameters
    // -----------------------------------------
    parameter GROUP = 6;
    parameter WIDTH = 8;

    // -----------------------------------------
    // DUT I/O
    // -----------------------------------------
    reg  signed [GROUP*WIDTH-1:0] in_llr;
    wire signed [GROUP*WIDTH-1:0] out_llr;

    // -----------------------------------------
    // Instantiate DUT
    // -----------------------------------------
    cn_proc #(
        .GROUP(GROUP),
        .WIDTH(WIDTH)
    ) dut (
        .in_llr(in_llr),
        .out_llr(out_llr)
    );

    // -----------------------------------------
    // Reference model variables
    // -----------------------------------------
    integer i, j;

    reg [WIDTH-1:0] abs_val   [0:GROUP-1];
    reg             sign_val  [0:GROUP-1];

    reg [WIDTH-1:0] min1, min2;
    integer min1_idx;

    reg total_sign;

    reg signed [WIDTH-1:0] expected [0:GROUP-1];

    // -----------------------------------------
    // Reference model task
    // -----------------------------------------
    task compute_reference;
        begin
            // Extract abs + sign
            for (i = 0; i < GROUP; i = i + 1) begin
                if (in_llr[i*WIDTH + WIDTH-1])
                    abs_val[i] = -in_llr[i*WIDTH +: WIDTH];
                else
                    abs_val[i] =  in_llr[i*WIDTH +: WIDTH];

                sign_val[i] = in_llr[i*WIDTH + WIDTH-1];
            end

            // Find min1, min2
            min1 = {WIDTH{1'b1}};
            min2 = {WIDTH{1'b1}};
            min1_idx = 0;

            for (i = 0; i < GROUP; i = i + 1) begin
                if (abs_val[i] < min1) begin
                    min2 = min1;
                    min1 = abs_val[i];
                    min1_idx = i;
                end else if (abs_val[i] < min2) begin
                    min2 = abs_val[i];
                end
            end

            // Total sign
            total_sign = 0;
            for (i = 0; i < GROUP; i = i + 1)
                total_sign = total_sign ^ sign_val[i];

            // Compute expected outputs
            for (i = 0; i < GROUP; i = i + 1) begin
                reg [WIDTH-1:0] mag;
                reg sign;

                if (i == min1_idx)
                    mag = min2;
                else
                    mag = min1;

                sign = total_sign ^ sign_val[i];

                if (sign)
                    expected[i] = -mag;
                else
                    expected[i] = mag;
            end
        end
    endtask

    // -----------------------------------------
    // Compare task
    // -----------------------------------------
    task check_output;
        begin
            for (j = 0; j < GROUP; j = j + 1) begin
                if (out_llr[j*WIDTH +: WIDTH] !== expected[j]) begin
                    $display("MISMATCH at index %0d: DUT=%0d EXPECTED=%0d",
                             j,
                             out_llr[j*WIDTH +: WIDTH],
                             expected[j]);
                end else begin
                    $display("OK index %0d: %0d",
                             j,
                             out_llr[j*WIDTH +: WIDTH]);
                end
            end
        end
    endtask

    // -----------------------------------------
    // Test sequence
    // -----------------------------------------
    initial begin
        $display("==== CN PROC TESTBENCH START ====");

        // Test 1: simple values
        in_llr = {
            8'sd3, 8'sd-2, 8'sd7,
            8'sd-1, 8'sd4, 8'sd-6
        };
        #5;
        compute_reference();
        check_output();

        // Test 2: all positive
        in_llr = {
            8'sd1, 8'sd2, 8'sd3,
            8'sd4, 8'sd5, 8'sd6
        };
        #5;
        compute_reference();
        check_output();

        // Test 3: all negative
        in_llr = {
            -8'sd1, -8'sd2, -8'sd3,
            -8'sd4, -8'sd5, -8'sd6
        };
        #5;
        compute_reference();
        check_output();

        // Test 4: random
        for (i = 0; i < GROUP; i = i + 1) begin
            in_llr[i*WIDTH +: WIDTH] = $random;
        end
        #5;
        compute_reference();
        check_output();

        $display("==== TESTBENCH END ====");
        $finish;
    end

endmodule`timescale 1ns/1ps

module tb_cn_proc;

parameter GROUP = 6;
parameter WIDTH = 8;

reg  signed [GROUP*WIDTH-1:0] in_llr;
wire signed [GROUP*WIDTH-1:0] out_llr;

cn_proc #(
    .GROUP(GROUP),
    .WIDTH(WIDTH)
) dut (
    .in_llr(in_llr),
    .out_llr(out_llr)
);

integer i, j;

reg [WIDTH-1:0] abs_val   [0:GROUP-1];
reg             sign_val  [0:GROUP-1];

reg [WIDTH-1:0] min1, min2;
integer min1_idx;

reg total_sign;

reg signed [WIDTH-1:0] expected [0:GROUP-1];

// moved declarations here (fix #1)
reg [WIDTH-1:0] mag;
reg sign;

task compute_reference;
begin
    // Extract abs + sign
    for (i = 0; i < GROUP; i = i + 1) begin
        if ($signed(in_llr[i*WIDTH +: WIDTH]) < 0)
            abs_val[i] = -$signed(in_llr[i*WIDTH +: WIDTH]);
        else
            abs_val[i] =  $signed(in_llr[i*WIDTH +: WIDTH]);

        sign_val[i] = in_llr[i*WIDTH + WIDTH-1];
    end

    // Proper max init (fix #3)
    min1 = {1'b0, {(WIDTH-1){1'b1}}};
    min2 = min1;
    min1_idx = 0;

    for (i = 0; i < GROUP; i = i + 1) begin
        if (abs_val[i] < min1) begin
            min2 = min1;
            min1 = abs_val[i];
            min1_idx = i;
        end else if (abs_val[i] < min2) begin
            min2 = abs_val[i];
        end
    end

    total_sign = 0;
    for (i = 0; i < GROUP; i = i + 1)
        total_sign = total_sign ^ sign_val[i];

    for (i = 0; i < GROUP; i = i + 1) begin
        if (i == min1_idx)
            mag = min2;
        else
            mag = min1;

        sign = total_sign ^ sign_val[i];

        if (sign)
            expected[i] = -mag;
        else
            expected[i] = mag;
    end
end
endtask

task check_output;
begin
    for (j = 0; j < GROUP; j = j + 1) begin
        if ($signed(out_llr[j*WIDTH +: WIDTH]) !== expected[j]) begin
            $display("MISMATCH %0d: DUT=%0d EXP=%0d",
                j,
                $signed(out_llr[j*WIDTH +: WIDTH]),
                expected[j]);
        end else begin
            $display("OK %0d: %0d",
                j,
                expected[j]);
        end
    end
end
endtask

initial begin
    $display("==== CN PROC TEST ====");

    // FIXED ORDER (fix #4)
    in_llr = {
        8'sd-6, 8'sd4, 8'sd-1,
        8'sd7, 8'sd-2, 8'sd3
    };
    #5;
    compute_reference();
    check_output();

    $finish;
end

endmodule`timescale 1ns/1ps

