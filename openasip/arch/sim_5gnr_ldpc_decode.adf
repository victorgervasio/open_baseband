      <connects-to>RF_i1</connects-to>
    </port>
    <port name="rd">
      <connects-to>RF_o1</connects-to>
    </port>
  </register-file>

  <register-file name="bool">
    <type>normal</type>
    <size>2</size>
    <width>1</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>bool_i1</connects-to>
    </port>
    <port name="rd">
      <connects-to>bool_o1</connects-to>
    </port>
  </register-file>

  <register-file name="RF_1">
    <type>normal</type>
    <size>5</size>
    <width>32</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>RF_1_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>RF_1_i1</connects-to>
    </port>
  </register-file>

  <register-file name="bool_1">
    <type>normal</type>
    <size>2</size>
    <width>1</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>bool_1_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>bool_1_i1</connects-to>
    </port>
  </register-file>

  <register-file name="RF_1_1">
    <type>normal</type>
    <size>5</size>
    <width>32</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>RF_1_1_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>RF_1_1_i1</connects-to>
    </port>
  </register-file>

  <register-file name="RF_2">
    <type>normal</type>
    <size>5</size>
    <width>32</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>RF_2_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>RF_2_i1</connects-to>
    </port>
  </register-file>

  <register-file name="RF_1_2">
    <type>normal</type>
    <size>5</size>
    <width>32</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>RF_1_2_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>RF_1_2_i1</connects-to>
    </port>
  </register-file>

  <register-file name="bool_1_1">
    <type>normal</type>
    <size>2</size>
    <width>1</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
      <connects-to>bool_1_1_o1</connects-to>
    </port>
    <port name="rd">
      <connects-to>bool_1_1_i1</connects-to>
    </port>
  </register-file>

  <register-file name="bool_1_2">
    <type>normal</type>
    <size>2</size>
    <width>1</width>
    <max-reads>1</max-reads>
    <max-writes>1</max-writes>
    <port name="wr">
